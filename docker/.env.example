# Copy to .env or let ./oracle/deploy.sh create docker/.env automatically.
STREAM_USER=racer
STREAM_PASSWORD=replace-with-a-long-random-password
STREAM_DOMAIN=game.pyongyangracer.com
EMBED_ORIGINS=https://pyongyangracer.com http://pyongyangracer.com

# Queue gateway defaults (seconds except capacity/request count).
MAX_ACTIVE_SECONDS=900
HEARTBEAT_TIMEOUT_SECONDS=60
WAITING_EXPIRY_SECONDS=300
QUEUE_CAPACITY=50
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Session allocator: one isolated Flash container per player.
SESSION_SLOTS=8
SESSION_PER_IP=4
SESSION_IMAGE=pyongyang-racer-stream:live
SESSION_MEMORY_MB=768
SESSION_SHM_SIZE_MB=128
SESSION_START_TIMEOUT_SECONDS=120
DOCKER_GID=0
